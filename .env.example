# BloomOS environment configuration
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# .env.local is gitignored — never commit real values.
#
# Never put a service_role key, database password, access token, or any other
# secret credential in a NEXT_PUBLIC_* variable (or anywhere in this file) —
# NEXT_PUBLIC_* values are bundled into client-side JavaScript and are public.

# Data mode: "mock" (default — no Supabase needed, runs entirely on the
# in-memory mock data layer, resets on every reload) or "supabase" (every
# module is live on the connected project; requires the two variables below).
# See docs/integrations.md for the full module-by-module status.
NEXT_PUBLIC_DATA_MODE=mock

# Supabase project URL and anon (public) key — both are safe for client-side
# exposure by design. Find them in Supabase Dashboard → Project Settings → API.
# Leave blank while NEXT_PUBLIC_DATA_MODE=mock.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
